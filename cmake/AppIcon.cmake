# Application icon (resources/icons, generated by scripts/make-icons.py).
set(DESKFLOWER_ICONS_DIR ${PROJECT_SOURCE_DIR}/resources/icons)

# Embeds the icon into an executable: a Windows resource, or the bundle icon on macOS (app bundles only).
function(deskflower_add_app_icon target)
    get_target_property(bundle ${target} MACOSX_BUNDLE)
    if(WIN32)
        target_sources(${target} PRIVATE ${PROJECT_SOURCE_DIR}/resources/deskflower.rc)
        # The resource compiler's dependency scan does not see ICON files.
        set_source_files_properties(${PROJECT_SOURCE_DIR}/resources/deskflower.rc PROPERTIES
                                    OBJECT_DEPENDS ${DESKFLOWER_ICONS_DIR}/deskflower.ico)
    elseif(APPLE AND bundle)
        set(icns ${DESKFLOWER_ICONS_DIR}/deskflower.icns)
        set_source_files_properties(${icns} PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
        target_sources(${target} PRIVATE ${icns})
        set_target_properties(${target} PROPERTIES MACOSX_BUNDLE_ICON_FILE deskflower.icns)
    endif()
endfunction()
